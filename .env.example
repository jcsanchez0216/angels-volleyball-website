# Athlete Participant Agreement (Academy and Hybrid).
# Copy to .env.local for local builds. GitHub Pages bakes these in at
# `npm run build`, so set them in the environment before `npm run deploy`.
#
# Recipient printed in the 2026-27 Club Handbook. Change it if Theresa
# wants a different inbox. Formspree delivers to the address on the form
# you create, not to this string by itself.
REACT_APP_PARTICIPANT_FORM_EMAIL=Theresa@angelsofalbuquerque.com

# Paste the Formspree endpoint after the form is created and verified.
# Leave blank until then. The site will show an error on submit.
# REACT_APP_PARTICIPANT_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
REACT_APP_PARTICIPANT_FORM_ENDPOINT=
